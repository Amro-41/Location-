<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Location Sharing</title>
</head>

<body>
  <h2>Live Location Sharing</h2>
  <button id="start">Start Sharing My Location</button>
  <p id="status">Not sharing</p>

  <script type="module">
    import { initializeApp }
      from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";

    import {
      getDatabase,
      ref,
      set
    } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyAcZ7ZXY3rTkZT6jZ55Tm9qDQicMJ6E2jA",
      authDomain: "amrolocation.firebaseapp.com",
      databaseURL: "https://amrolocation-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "amrolocation",
      storageBucket: "amrolocation.firebasestorage.app",
      messagingSenderId: "157641871095",
      appId: "1:157641871095:web:4b197ee8474938c83c0df2"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    let watchId = null;

    document.getElementById("start").onclick = () => {

      if (!navigator.geolocation) {
        document.getElementById("status").textContent =
          "Location is not supported.";
        return;
      }

      document.getElementById("status").textContent =
        "Requesting location permission...";

      watchId = navigator.geolocation.watchPosition(
        async (position) => {

          const latitude = position.coords.latitude;
          const longitude = position.coords.longitude;

          await set(ref(db, "sharedLocation"), {
            latitude: latitude,
            longitude: longitude,
            accuracy: position.coords.accuracy,
            time: Date.now()
          });

          document.getElementById("status").textContent =
            "🟢 Live location is ON";
        },

        (error) => {
          document.getElementById("status").textContent =
            "Location permission is required.";
          console.log(error);
        },

        {
          enableHighAccuracy: true,
          maximumAge: 5000,
          timeout: 10000
        }
      );
    };
  </script>
</body>
</html>
